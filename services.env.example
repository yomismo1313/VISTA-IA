# Red
SERVER_IP=192.168.1.9
ESP32_IP=192.168.1.10
ESP32_CAPTURE_PATH=/capture

# Puertos
GATEWAY_PORT=8080
VISION_PORT=8081
VOZ_PORT=8082
MUSICA_PORT=8083
TCP_SPK_PORT=5002

# Audio
SAMPLE_RATE=16000
VOZ_REFERENCIA=/home/mi_voz.wav

# Modelos
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava:latest
MODELS_DIR=../models

# Radio
RADIO_DEFAULT=http://stream.zeno.fm/f3wvbbqmdg8uv

# Local

# ── Salida de audio ──
# 1 = activado, 0 = desactivado
AUDIO_LOCAL=1
AUDIO_TCP=0

# Dispositivo ALSA local (opcional). Ejemplos:
#   default   → el que tenga el sistema por defecto
#   plughw:0,0
#   pulse     → si usas PipeWire/PulseAudio
AUDIO_LOCAL_DEVICE=default

# Volumen para aplay (0..100). Solo aplica si usas aplay.
AUDIO_LOCAL_VOLUME=80
